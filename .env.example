# ==============================================================================
# Waifu on Telegram - Environment Configuration Template
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram User ID (single ID or comma-separated for authorized users)
# Get your ID from @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# 3. AI Engine Architecture Mode: unified (default 1 provider) atau split (pisah SFW & NSFW)
AI_ENGINE_MODE=unified

# Default Unified LLM Backend (KoboldCPP / Locally Uncensored / Ollama / LM Studio)
LLM_BASE_URL=http://127.0.0.1:5001/v1
LLM_API_KEY=kobold
LLM_MODEL=default

# --- [OPTIONAL: Split Hybrid SFW vs NSFW Providers] ---
# Jika AI_ENGINE_MODE=split:
# SFW Provider: openai, groq, deepseek, openrouter, local, ollama, atau custom
SFW_LLM_PROVIDER=openai
SFW_LLM_BASE_URL=https://api.openai.com/v1
SFW_LLM_API_KEY=your_openai_api_key_here
SFW_LLM_MODEL=gpt-4o-mini

# NSFW Provider: local (KoboldCPP Uncensored), openrouter_uncensored, atau custom
NSFW_LLM_PROVIDER=local
NSFW_LLM_BASE_URL=http://127.0.0.1:5001/v1
NSFW_LLM_API_KEY=kobold
NSFW_LLM_MODEL=default

# 4. Image & Video Generation (Local ComfyUI / Cloud)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=AOM3A1B_orangemixs.safetensors
MEDIA_FALLBACK_CLOUD=true
MEDIA_VAULT_REUSE=false
MEDIA_VAULT_FALLBACK=true

# --- [OPTIONAL: Split SFW vs NSFW Image Engines] ---
# SFW_IMAGE_ENGINE: comfyui (Anything XL / MeinaMix), agy (Google Antigravity CLI / Bridge), atau cloud
SFW_IMAGE_ENGINE=agy
MEDIA_FALLBACK_AGY=true
SFW_COMFYUI_CHECKPOINT=AnythingXL_xl.safetensors
NSFW_IMAGE_ENGINE=comfyui
NSFW_COMFYUI_CHECKPOINT=AOM3A1B_orangemixs.safetensors

# Video Generator Engine: wan21 (Wan 2.1 1.3B), animatediff (SD 1.5 Anime), or motion (Fast 2.5D Parallax)
VIDEO_ENGINE=wan21

# 5. Persona, Language & Romance Settings
DEFAULT_PERSONA=runa
BOT_LANGUAGE=id
AFFINITY_SYSTEM_ENABLED=true

# 6. Spoken Voice Note Settings (Tombol Suara 🔊 On-Demand di setiap chat)
# (Setting on/off voice dihapus: tombol suara 🔊 selalu aktif di setiap chat)
VOICE_NAME=id-ID-GadisNeural
VOICE_SPEED=+0%

# 7. PC Music Remote Control (YouTube Music Player on Port 8002)
MUSIC_FEATURE_ENABLED=true
MUSIC_AUTO_PLAY_PC=true
MUSIC_PLAYER_PORT=8002

# 8. Optional Cloud Fallbacks (Leave blank to stay 100% local)
GROQ_API_KEY=
OPENAI_API_KEY=

# 9. Health Check, PC Startup Notifications & Self-Healing
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
STARTUP_NOTIFICATION_ENABLED=true
SELF_HEALING_ENABLED=true

# 10. Smart Idle & Dynamic Power Saver (Hemat 6-8 GB VRAM, RAM & Disk saat bot idle, default 2 jam)
# Otomatis melepaskan model dari VRAM & RAM setelah tidak ada chat selama X menit.
# Wakes up instan dan otomatis saat Anda mengirim pesan baru di Telegram.
SMART_IDLE_ENABLED=true
IDLE_TIMEOUT_MINUTES=120
COMFYUI_ON_DEMAND=true
# Otomatis swap VRAM (tidurkan KoboldCPP saat ComfyUI render & sebaliknya) di GPU <= 6.5 GB (auto|true|false)
VRAM_EXCLUSIVE_SWAP=auto
# Mode VRAM ComfyUI: auto (--lowvram otomatis di GPU <= 6.5 GB), lowvram, medvram, normalvram
COMFYUI_VRAM_MODE=auto
# Otomatis lepas cache model ComfyUI dari VRAM setelah gambar/video selesai dibuat
COMFYUI_FREE_VRAM_AFTER_GEN=true

# 11. Google Antigravity CLI Bridge (AGY OpenAI Bridge on Port 8001)
# Menyediakan endpoint OpenAI-compatible lokal untuk waifu dan aplikasi eksternal (Cursor, VSCode, LibreChat, dll.)
AGY_BRIDGE_ENABLED=true
AGY_BRIDGE_PORT=8001
AGY_DEFAULT_MODEL=gemini-3.8-flash-medium
AGY_BRIDGE_API_KEY=sk-agy-secret-key-12345


# 12. Multi-Project Coding Workspace & Computer Use (agent-desktop)
# Waifu dapat membantu tugas programming & coding user di folder project yang dipilih
# PROJECTS_DIR: Root folder tempat koleksi project Anda berada (default: User Home Directory e.g. ~ atau C:\Users\username)
PROJECTS_DIR=
DEFAULT_PROJECT_NAME=general
COMPUTER_USE_ENABLED=true


# 13. VoiceStudio Local AI Voice Server (debpalash/VoiceStudio)
# Backend TTS lokal mandiri (FastAPI port 3900) dengan voice cloning & persona conditioning
VOICE_BACKEND=edge-tts
VOICESTUDIO_PORT=3900
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_DEFAULT_MODEL=omnivoice
