# ==============================================================================
# Waifu on Telegram - Environment Configuration Template
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram User ID (single ID or comma-separated for authorized users)
# Get your ID from @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# 3. AI Engine Architecture Mode: unified (default 1 provider) atau split (pisah SFW & NSFW)
AI_ENGINE_MODE=unified

# Default Unified LLM Backend (KoboldCPP / Locally Uncensored / Ollama / LM Studio)
LLM_BASE_URL=http://127.0.0.1:5001/v1
LLM_API_KEY=kobold
LLM_MODEL=default

# --- [OPTIONAL: Split Hybrid SFW vs NSFW Providers] ---
# Jika AI_ENGINE_MODE=split:
# SFW Provider: openai, groq, deepseek, openrouter, local, ollama, atau custom
SFW_LLM_PROVIDER=openai
SFW_LLM_BASE_URL=https://api.openai.com/v1
SFW_LLM_API_KEY=your_openai_api_key_here
SFW_LLM_MODEL=gpt-4o-mini

# NSFW Provider: local (KoboldCPP Uncensored), openrouter_uncensored, atau custom
NSFW_LLM_PROVIDER=local
NSFW_LLM_BASE_URL=http://127.0.0.1:5001/v1
NSFW_LLM_API_KEY=kobold
NSFW_LLM_MODEL=default

# 4. Image & Video Generation (Local ComfyUI / Cloud)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=meinamix_v12Final.safetensors
MEDIA_FALLBACK_CLOUD=false

# --- [OPTIONAL: Split SFW vs NSFW Image Engines] ---
SFW_IMAGE_ENGINE=comfyui
SFW_COMFYUI_CHECKPOINT=AnythingXL_xl.safetensors
NSFW_IMAGE_ENGINE=comfyui
NSFW_COMFYUI_CHECKPOINT=AOM3A1B_orangemixs.safetensors

# Video Generator Engine: wan21 (Wan 2.1 1.3B), animatediff (SD 1.5 Anime), or motion (Fast 2.5D Parallax)
VIDEO_ENGINE=wan21

# 5. Persona, Language & Romance Settings
DEFAULT_PERSONA=runa
BOT_LANGUAGE=id
AFFINITY_SYSTEM_ENABLED=true

# 6. Spoken Voice Note Settings (Edge-TTS)
VOICE_REPLY_ENABLED=true
VOICE_NAME=id-ID-GadisNeural
VOICE_SPEED=+0%

# 7. PC Music Remote Control (YouTube Music Player on Port 8002)
MUSIC_FEATURE_ENABLED=true
MUSIC_AUTO_PLAY_PC=true
MUSIC_PLAYER_PORT=8002

# 8. Optional Cloud Fallbacks (Leave blank to stay 100% local)
GROQ_API_KEY=
OPENAI_API_KEY=

# 9. Health Check, PC Startup Notifications & Self-Healing
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
STARTUP_NOTIFICATION_ENABLED=true
SELF_HEALING_ENABLED=true

# 10. Smart Idle & Dynamic Power Saver (Hemat 6-8 GB VRAM, RAM & Disk saat bot idle)
# Otomatis melepaskan model dari VRAM & RAM setelah tidak ada chat selama X menit.
# Wakes up instan dan otomatis saat Anda mengirim pesan baru di Telegram.
SMART_IDLE_ENABLED=true
IDLE_TIMEOUT_MINUTES=10
COMFYUI_ON_DEMAND=true
