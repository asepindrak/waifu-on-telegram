# ==============================================================================
# Waifu on Telegram - Environment Configuration Template
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram User ID (single ID or comma-separated for authorized users)
# Get your ID from @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# 3. Local LLM Backend (KoboldCPP / Locally Uncensored / Ollama / LM Studio)
# Default for KoboldCPP (Auto-starts & Auto-loads GGUF model): http://127.0.0.1:5001/v1
LLM_BASE_URL=http://127.0.0.1:5001/v1
LLM_API_KEY=kobold
LLM_MODEL=default

# 4. Image & Video Generation (Local ComfyUI)
COMFYUI_URL=http://127.0.0.1:8188
# Model Checkpoint: meinamix_v12Final.safetensors (SD 1.5, 4-8GB VRAM) atau AnythingXL_xl.safetensors (SDXL 1024px, 8GB+ VRAM Civitai #9409)
COMFYUI_CHECKPOINT=meinamix_v12Final.safetensors
MEDIA_FALLBACK_CLOUD=false

# Video Generator Engine: wan21 (Wan 2.1 1.3B), animatediff (SD 1.5 Anime), or motion (Fast 2.5D Parallax)
VIDEO_ENGINE=wan21

# 5. Persona, Language & Romance Settings
DEFAULT_PERSONA=runa
BOT_LANGUAGE=id
AFFINITY_SYSTEM_ENABLED=true

# 6. Spoken Voice Note Settings (Edge-TTS)
VOICE_REPLY_ENABLED=true
VOICE_NAME=id-ID-GadisNeural
VOICE_SPEED=+0%

# 7. PC Music Remote Control (YouTube Music Player on Port 8002)
MUSIC_FEATURE_ENABLED=true
MUSIC_AUTO_PLAY_PC=true
MUSIC_PLAYER_PORT=8002

# 8. Optional Cloud Fallbacks (Leave blank to stay 100% local)
GROQ_API_KEY=
OPENAI_API_KEY=

# 9. Health Check, PC Startup Notifications & Self-Healing
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
STARTUP_NOTIFICATION_ENABLED=true
SELF_HEALING_ENABLED=true
